<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon for the (disabled) MainActivityStatic launcher alias. It used to carry the
  old red Echo mark, which left a second, stale identity in the tree; it now uses
  the same "Muestreo" layers as the main icon so no alias can show old art.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_aura_bg" />
    <foreground android:drawable="@drawable/ic_launcher_aura_fg" />
    <monochrome android:drawable="@drawable/ic_launcher_aura_mono" />
</adaptive-icon>
