<!--
  Aura Hi-Res launcher icon - "Muestreo" (Sampling), background layer.
  Ground #080D18 (near-black with a blue bias) plus a soft radial bloom of the
  brand blue #2FA6F0 at 38% alpha (#61 = 97/255), fading to 0 at radius 48.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground -->
    <path
        android:fillColor="#FF080D18"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Bloom behind the mark -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48">
                <item android:offset="0" android:color="#612FA6F0" />
                <item android:offset="1" android:color="#002FA6F0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
